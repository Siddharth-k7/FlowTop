{
  "name": "@flowtop/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design system and UI components for Flowtop",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "files": [
    "src",
    "tailwind-preset.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test test/components.test.mjs test/aria.test.mjs test/sections.test.mjs test/safeHref.test.mjs test/sections-render.test.mjs",
    "test:components": "node --test test/components.test.mjs",
    "test:aria": "node --test test/aria.test.mjs",
    "test:sections": "node --test test/sections.test.mjs",
    "test:safeHref": "node --test test/safeHref.test.mjs",
    "test:render": "node --test test/sections-render.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
