# Copy to .env and fill in. Never commit .env.
# Values here are empty or obviously fake on purpose. Never put a real secret in this file.

# ─── API ───────────────────────────────────────────────────────────────────
# The app refuses to start if any of these is missing or invalid.

# development | test | production. Swagger at /docs is served only outside production.
NODE_ENV=development

# Port the API listens on.
PORT=4000

# PostgreSQL connection string. Locally, the docker compose database is user flowtop,
# database flowtop, port FLOWTOP_DB_PORT, password POSTGRES_PASSWORD.
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/flowtop

# Comma-separated origins allowed to call the API with the session cookie: public site, admin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Base URL of the admin app. Password reset links point here.
ADMIN_URL=http://localhost:3001

# 32 random bytes, base64. Encrypts MFA secrets at rest. Generate with: openssl rand -base64 32
# Changing it makes every stored MFA secret unreadable, so treat it like a database password.
MFA_ENCRYPTION_KEY=

# Optional. Number of reverse proxies in front of the API (load balancer, CDN). Default 0.
# Must equal the real number of proxies. On Render it is 1 (set in infra/render.yaml).
# Too low: every client shares the proxy's IP for rate limiting.
# Too high, or set with no proxy in front: clients can fake their IP and skip every
# per-IP rate limit. Leave it unset for local development. See the root README.
# TRUST_PROXY_HOPS=1

# ─── Media storage ─────────────────────────────────────────────────────────
# Two buckets: public (product photos, CDN, permanent URLs) and private (customer
# documents, links that expire after 15 minutes). The driver picks where they live.

# local: two folders on this machine, served by the API. Development and tests only;
#        the API refuses to start with it in production.
# s3:    any S3-compatible service (AWS S3, Cloudflare R2, MinIO). Staging and production.
MEDIA_STORAGE_DRIVER=local

# Where public files are served from. Production: the CDN in front of the public bucket.
# local driver: the API's own file route, as below.
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/api/v1/files/public

# local driver only.
MEDIA_LOCAL_DIR=.media
MEDIA_LOCAL_PRIVATE_BASE_URL=http://localhost:4000/api/v1/files/private
# 32 random bytes, base64. Signs private file links. Generate with: openssl rand -base64 32
MEDIA_URL_SIGNING_KEY=

# s3 driver only. The private bucket must block all public access.
# S3_REGION=ap-south-1
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=
# Set S3_ENDPOINT for R2, MinIO and other non-AWS services; leave it unset for AWS.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# Optional: without these the AWS SDK uses its default chain, such as an IAM role.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Local database (docker-compose.yml) ───────────────────────────────────
# Read by `docker compose`, not by the API. Both are required: compose refuses to start without them.

# Password for the local Postgres container. Generate one with: openssl rand -hex 24
# Set it before the first `docker compose up`: Postgres only reads it when the volume is created.
POSTGRES_PASSWORD=

# Host port for the local Postgres container. 5433 avoids clashing with another local Postgres on 5432.
FLOWTOP_DB_PORT=5433

# ─── Seed (npm run db:seed) ────────────────────────────────────────────────
# Optional. When both are set, the seed creates a super_admin to log in with. It never
# overwrites an existing user. Use your own email and a password of 12+ characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ─── Tests ─────────────────────────────────────────────────────────────────
# Database the e2e tests create, migrate and wipe. Must not be your development database:
# the name must contain "test". Locally, same server and credentials as DATABASE_URL.
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5433/flowtop_test
