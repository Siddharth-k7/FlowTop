# Copy to .env and fill in. Never commit .env.
# Values here are empty or obviously fake on purpose. Never put a real secret in this file.

# ─── API ───────────────────────────────────────────────────────────────────
# The app refuses to start if any of these is missing or invalid.

# development | test | production. Swagger at /docs is served only outside production.
NODE_ENV=development

# Port the API listens on.
PORT=4000

# PostgreSQL connection string. Locally, use the docker compose database:
#   postgresql://flowtop:<POSTGRES_PASSWORD>@localhost:5433/flowtop
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/flowtop

# Comma-separated origins allowed to call the API with the session cookie: public site, admin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Base URL of the admin app. Password reset links point here.
ADMIN_URL=http://localhost:3001

# 32 random bytes, base64. Encrypts MFA secrets at rest. Generate with: openssl rand -base64 32
# Changing it makes every stored MFA secret unreadable, so treat it like a database password.
MFA_ENCRYPTION_KEY=

# Optional. Number of reverse proxies in front of the API (load balancer, CDN). Default 0.
# Must be set in staging and production, or every client shares the proxy's IP for rate limiting.
# TRUST_PROXY_HOPS=1

# ─── Local database (docker-compose.yml) ───────────────────────────────────
# Read by `docker compose`, not by the API.

# Password for the local Postgres container. Empty means the default, "localdev".
# Set it before the first `docker compose up`: Postgres only reads it when the volume is created.
POSTGRES_PASSWORD=

# Host port for the local Postgres container. Empty means 5433.
FLOWTOP_DB_PORT=

# ─── Tests ─────────────────────────────────────────────────────────────────
# Database the e2e tests create, migrate and wipe. Must not be your development database.
#   postgresql://flowtop:<POSTGRES_PASSWORD>@localhost:5433/flowtop_test
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/flowtop_test
