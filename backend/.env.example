# Copy to .env and fill in. Never commit .env.
# The app refuses to start if any of these is missing or invalid.

# development | test | production. Swagger at /docs is served only outside production.
NODE_ENV=development

# Port the API listens on.
PORT=4000

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/flowtop

# Comma-separated origins allowed to call the API with the session cookie: public site, admin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
