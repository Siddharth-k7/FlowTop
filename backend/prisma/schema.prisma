// Flowtop data model. Source of truth: docs/04-data-model.md.
// Owner: Dev A. Dev B proposes content table changes through Dev A.
//
// Conventions (from the doc):
// - Tables are singular snake_case, columns snake_case; Prisma fields are camelCase via @map.
// - Money is Int paise. Never Float, never Decimal.
// - Timestamps are timestamptz, stored in UTC.
// - Every table has created_at and updated_at.
// - Soft delete is status = archived. FKs from orders are Restrict, so a referenced row cannot be hard deleted.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────
// Values are lowercase so they match the API contract strings exactly.

enum PublishStatus {
  draft
  published
  unpublished
  archived

  @@map("publish_status")
}

enum SpecificationType {
  text
  number
  boolean
  choice

  @@map("specification_type")
}

enum PlacementLocationType {
  homepage_section
  category
  collection
  campaign_page
  related

  @@map("placement_location_type")
}

enum SectionType {
  hero
  product_carousel
  collection_showcase
  image_text
  gallery
  cta

  @@map("section_type")
}

enum MediaBucket {
  public
  private

  @@map("media_bucket")
}

enum ProductMediaRole {
  primary
  gallery

  @@map("product_media_role")
}

enum NavigationMenu {
  header
  footer

  @@map("navigation_menu")
}

/// What a navigation item points at. The href is built at render time, never stored.
enum NavigationLinkType {
  page
  category
  collection
  product
  external

  @@map("navigation_link_type")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded

  @@map("payment_status")
}

enum OrderStatus {
  received
  confirmed
  shipped
  cancelled

  @@map("order_status")
}

enum SubmissionType {
  contact
  dealer

  @@map("submission_type")
}

enum SubmissionStatus {
  new
  read
  handled

  @@map("submission_status")
}

// ─── Platform: users, roles, permissions ───────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// Stored lowercase. Lookups normalise the input the same way.
  email        String   @unique
  /// argon2id. Never plaintext, never a fast hash.
  passwordHash String   @map("password_hash")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  /// Encrypted at rest by the auth module, never stored in plain text.
  mfaSecret    String?  @map("mfa_secret")
  /// Deactivated users keep their history but cannot log in.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles               UserRole[]
  sessions            Session[]
  mfaChallenges       MfaChallenge[]
  passwordResetTokens PasswordResetToken[]
  uploadedMedia       MediaAsset[]         @relation("MediaUploadedBy")
  updatedSettings     Setting[]            @relation("SettingUpdatedBy")
  auditEvents         AuditEvent[]

  @@map("user")
}

// ─── Platform: auth ────────────────────────────────────────────────────────
// Every token below is a random secret handed to the client once. Only its
// SHA-256 hash is stored, so a database leak does not leak usable tokens.

/// An admin session. The raw token lives only in the httpOnly session cookie.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

/// The second login step for an MFA user: the mfaToken returned by POST /auth/login. Short lived, single use.
model MfaChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when the challenge is used or burned by too many wrong codes. Never cleared.
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  failedAttempts Int       @default(0) @map("failed_attempts")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenge")
}

/// Single use, expires 30 minutes after issue.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when used, or when a newer token for the same user replaces it.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// super_admin, marketing_admin, product_manager in v1. The table supports all six SRS roles.
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  /// resource:action, for example product:update or settings:write.
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permission")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ─── Core content: products ────────────────────────────────────────────────

model Product {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  sku                 String        @unique
  slug                String        @unique
  categoryId          String?       @map("category_id") @db.Uuid
  shortDescription    String        @default("") @map("short_description")
  /// Rich text as HTML.
  fullDescription     String        @default("") @map("full_description")
  /// Paise, not rupees.
  price               Int
  /// Paise.
  salePrice           Int?          @map("sale_price")
  taxClass            String        @default("standard") @map("tax_class")
  /// false means enquiry-only, no cart button.
  isPurchasable       Boolean       @default(true) @map("is_purchasable")
  /// Manual toggle (data model assumption 2: no stock counts).
  isAvailable         Boolean       @default(true) @map("is_available")
  availabilityMessage String?       @map("availability_message")
  /// A hint for rule-based sections, never a placement.
  isFeatured          Boolean       @default(false) @map("is_featured")
  isNewArrival        Boolean       @default(false) @map("is_new_arrival")
  isBestseller        Boolean       @default(false) @map("is_bestseller")
  status              PublishStatus @default(draft)
  publishedAt         DateTime?     @map("published_at") @db.Timestamptz(6)
  seoTitle            String        @default("") @map("seo_title")
  seoDescription      String        @default("") @map("seo_description")
  seoCanonical        String?       @map("seo_canonical")
  seoShareImageId     String?       @map("seo_share_image_id") @db.Uuid
  /// Deferred: 3D viewer. Column now, feature later. Build nothing that uses it in v1.
  modelUrl            String?       @map("model_url")
  /// Deferred: product video. Column now, feature later.
  videoUrl            String?       @map("video_url")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seoShareImage  MediaAsset?         @relation("ProductSeoShareImage", fields: [seoShareImageId], references: [id], onDelete: Restrict)
  variants       Variant[]
  specifications Specification[]
  media          ProductMedia[]
  documents      ProductDocument[]
  collections    CollectionProduct[]
  placements     Placement[]
  relatedTo      RelatedProduct[]    @relation("RelatedFrom")
  relatedFrom    RelatedProduct[]    @relation("RelatedTo")
  articles       ArticleProduct[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@map("product")
}

/// One row per finish.
model Variant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  /// "Chrome", "Matte Black".
  name          String
  skuSuffix     String   @map("sku_suffix")
  /// Paise. Null means the product price applies.
  priceOverride Int?     @map("price_override")
  /// Finish swatch colour, returned as swatchHex by the API.
  swatchHex     String?  @map("swatch_hex")
  imageId       String?  @map("image_id") @db.Uuid
  isAvailable   Boolean  @default(true) @map("is_available")
  /// At most one true per product is enforced by the partial unique index below; the service ensures at least one.
  isDefault     Boolean  @default(false) @map("is_default")
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  image      MediaAsset? @relation("VariantImage", fields: [imageId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([productId, skuSuffix])
  @@unique([productId], where: { isDefault: true }, map: "variant_one_default_per_product")
  @@map("variant")
}

/// Rows, never columns. This is what lets staff add "Spout Reach" without a developer.
/// A row with an empty value is never created.
model Specification {
  id        String            @id @default(uuid()) @db.Uuid
  productId String            @map("product_id") @db.Uuid
  /// "Technical", "Installation".
  group     String?
  /// "Material".
  name      String
  /// "Brass".
  value     String
  /// "mm", "LPM".
  unit      String?
  type      SpecificationType @default(text)
  position  Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("specification")
}

model Category {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  slug            String        @unique
  description     String?
  /// One level only. Enforced by the categories service.
  parentId        String?       @map("parent_id") @db.Uuid
  imageId         String?       @map("image_id") @db.Uuid
  /// Drives menu and listing order.
  position        Int           @default(0)
  status          PublishStatus @default(draft)
  seoTitle        String        @default("") @map("seo_title")
  seoDescription  String        @default("") @map("seo_description")
  seoCanonical    String?       @map("seo_canonical")
  seoShareImageId String?       @map("seo_share_image_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent        Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[]  @relation("CategoryTree")
  image         MediaAsset? @relation("CategoryImage", fields: [imageId], references: [id], onDelete: Restrict)
  seoShareImage MediaAsset? @relation("CategorySeoShareImage", fields: [seoShareImageId], references: [id], onDelete: Restrict)
  products      Product[]

  @@index([parentId, position])
  @@map("category")
}

model Collection {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  slug            String        @unique
  description     String?
  /// Rich text as HTML.
  story           String        @default("")
  imageId         String?       @map("image_id") @db.Uuid
  heroMediaId     String?       @map("hero_media_id") @db.Uuid
  position        Int           @default(0)
  status          PublishStatus @default(draft)
  seoTitle        String        @default("") @map("seo_title")
  seoDescription  String        @default("") @map("seo_description")
  seoCanonical    String?       @map("seo_canonical")
  seoShareImageId String?       @map("seo_share_image_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  image         MediaAsset?         @relation("CollectionImage", fields: [imageId], references: [id], onDelete: Restrict)
  heroMedia     MediaAsset?         @relation("CollectionHeroMedia", fields: [heroMediaId], references: [id], onDelete: Restrict)
  seoShareImage MediaAsset?         @relation("CollectionSeoShareImage", fields: [seoShareImageId], references: [id], onDelete: Restrict)
  products      CollectionProduct[]

  @@index([position])
  @@map("collection")
}

/// Ranked products in a collection. Unique on the pair.
model CollectionProduct {
  collectionId String   @map("collection_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, position])
  @@index([productId])
  @@map("collection_product")
}

model RelatedProduct {
  productId        String   @map("product_id") @db.Uuid
  relatedProductId String   @map("related_product_id") @db.Uuid
  position         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId])
  @@index([relatedProductId])
  @@map("related_product")
}

// ─── Placement: the headline feature ───────────────────────────────────────
// One row per (product, location). Deleting a row removes that one placement
// and touches nothing else. Never replace this with a column on product.

model Placement {
  id           String                @id @default(uuid()) @db.Uuid
  productId    String                @map("product_id") @db.Uuid
  locationType PlacementLocationType @map("location_type")
  /// The section key (featured, new_arrivals, bestsellers, recommended) or a category/collection/page uuid.
  locationId   String                @map("location_id")
  /// Order within that location.
  position     Int                   @default(0)
  /// Optional badge, "New".
  label        String?
  enabled      Boolean               @default(true)
  /// Deferred scheduling. Column now, feature later.
  activeFrom   DateTime?             @map("active_from") @db.Timestamptz(6)
  /// Deferred scheduling. Column now, feature later.
  activeTo     DateTime?             @map("active_to") @db.Timestamptz(6)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationType, locationId])
  /// The hot read: resolve a location's products in order.
  @@index([locationType, locationId, position])
  @@map("placement")
}

// ─── Pages and sections ────────────────────────────────────────────────────

/// The homepage is a Page with slug = ''.
model Page {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  slug            String        @unique
  template        String        @default("default")
  status          PublishStatus @default(draft)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  /// Deferred: scheduled publishing. Column now, feature later.
  scheduledAt     DateTime?     @map("scheduled_at") @db.Timestamptz(6)
  seoTitle        String        @default("") @map("seo_title")
  seoDescription  String        @default("") @map("seo_description")
  seoCanonical    String?       @map("seo_canonical")
  seoShareImageId String?       @map("seo_share_image_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seoShareImage MediaAsset? @relation("PageSeoShareImage", fields: [seoShareImageId], references: [id], onDelete: Restrict)
  sections      Section[]

  @@map("page")
}

model Section {
  id          String      @id @default(uuid()) @db.Uuid
  pageId      String      @map("page_id") @db.Uuid
  type        SectionType
  position    Int         @default(0)
  /// Hidden keeps it saved but off the page.
  visible     Boolean     @default(true)
  /// Shape per type is in docs/03-api-contract.md. Validated server-side against the preset enums.
  config      Json        @db.JsonB
  /// Deferred: scheduled publishing. Column now, feature later.
  scheduledAt DateTime?   @map("scheduled_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
  @@map("section")
}

// ─── Journal ───────────────────────────────────────────────────────────────

model JournalArticle {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  slug            String        @unique
  /// Free-text journal category, used by GET /journal?category=.
  category        String?
  excerpt         String        @default("")
  /// Rich text as HTML.
  body            String        @default("")
  heroImageId     String?       @map("hero_image_id") @db.Uuid
  status          PublishStatus @default(draft)
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(6)
  seoTitle        String        @default("") @map("seo_title")
  seoDescription  String        @default("") @map("seo_description")
  seoCanonical    String?       @map("seo_canonical")
  seoShareImageId String?       @map("seo_share_image_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  heroImage     MediaAsset?      @relation("ArticleHeroImage", fields: [heroImageId], references: [id], onDelete: Restrict)
  seoShareImage MediaAsset?      @relation("ArticleSeoShareImage", fields: [seoShareImageId], references: [id], onDelete: Restrict)
  products      ArticleProduct[]

  @@index([status, publishedAt])
  @@map("journal_article")
}

model ArticleProduct {
  articleId String   @map("article_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  article JournalArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@index([productId])
  @@map("article_product")
}

// ─── Navigation ────────────────────────────────────────────────────────────

/// Self-referencing, one level. Replaced wholesale by PUT /admin/navigation.
model NavigationItem {
  id           String             @id @default(uuid()) @db.Uuid
  menu         NavigationMenu
  label        String
  linkType     NavigationLinkType @map("link_type")
  /// A page, category, collection or product uuid for internal types; a URL for external.
  /// Storing the target instead of an href is what lets the API validate internal links and
  /// warn when a destination is unpublished (NAV-02). Shape enforced by a CHECK constraint.
  destination  String
  openInNewTab Boolean            @default(false) @map("open_in_new_tab")
  parentId     String?            @map("parent_id") @db.Uuid
  position     Int                @default(0)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   NavigationItem?  @relation("NavigationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationTree")

  @@index([menu, parentId, position])
  @@map("navigation_item")
}

// ─── Media ─────────────────────────────────────────────────────────────────
// Two buckets. Public: product photos, CDN served. Private: customer documents, signed URLs only.

model MediaAsset {
  id         String      @id @default(uuid()) @db.Uuid
  /// The original upload name, for display only. Never used as the storage key.
  filename   String
  mimeType   String      @map("mime_type")
  sizeBytes  Int         @map("size_bytes")
  bucket     MediaBucket
  /// Random, generated by the media module.
  storageKey String      @unique @map("storage_key")
  width      Int?
  height     Int?
  altText    String      @default("") @map("alt_text")
  /// Generated responsive sizes, filled in after background processing.
  variants   Json        @default("{}") @db.JsonB
  uploadedBy String      @map("uploaded_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploader User @relation("MediaUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)

  productMedia        ProductMedia[]
  productDocuments    ProductDocument[]
  variantImages       Variant[]         @relation("VariantImage")
  productSeoImages    Product[]         @relation("ProductSeoShareImage")
  categoryImages      Category[]        @relation("CategoryImage")
  categorySeoImages   Category[]        @relation("CategorySeoShareImage")
  collectionImages    Collection[]      @relation("CollectionImage")
  collectionHeroMedia Collection[]      @relation("CollectionHeroMedia")
  collectionSeoImages Collection[]      @relation("CollectionSeoShareImage")
  pageSeoImages       Page[]            @relation("PageSeoShareImage")
  articleHeroImages   JournalArticle[]  @relation("ArticleHeroImage")
  articleSeoImages    JournalArticle[]  @relation("ArticleSeoShareImage")

  @@index([bucket, createdAt])
  @@map("media_asset")
}

model ProductMedia {
  productId    String           @map("product_id") @db.Uuid
  mediaAssetId String           @map("media_asset_id") @db.Uuid
  position     Int              @default(0)
  role         ProductMediaRole @default(gallery)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([productId, mediaAssetId])
  @@index([productId, position])
  @@index([mediaAssetId])
  @@map("product_media")
}

model ProductDocument {
  productId    String   @map("product_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  /// Display name, "Installation Manual". Returned as documents[].name by the API.
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@id([productId, mediaAssetId])
  @@index([productId, position])
  @@index([mediaAssetId])
  @@map("product_document")
}

// ─── Commerce ──────────────────────────────────────────────────────────────

/// Guest checkout only (data model assumption 1: no customer accounts).
model Order {
  id                   String        @id @default(uuid()) @db.Uuid
  /// Human readable, FT-2026-00001.
  reference            String        @unique
  customerName         String        @map("customer_name")
  customerEmail        String        @map("customer_email")
  customerPhone        String        @map("customer_phone")
  deliveryAddressLine1 String        @map("delivery_address_line1")
  deliveryAddressLine2 String?       @map("delivery_address_line2")
  deliveryCity         String        @map("delivery_city")
  deliveryState        String        @map("delivery_state")
  /// 6-digit Indian PIN code.
  deliveryPin          String        @map("delivery_pin")
  deliveryLandmark     String?       @map("delivery_landmark")
  deliveryNotes        String?       @map("delivery_notes")
  /// Paise.
  subtotal             Int
  /// Paise.
  shipping             Int
  /// Paise.
  tax                  Int
  /// Paise.
  total                Int
  paymentStatus        PaymentStatus @default(pending) @map("payment_status")
  /// The payment idempotency key. Unique, so a retried webhook cannot create a second paid order.
  paymentGatewayId     String?       @unique @map("payment_gateway_id")
  /// Set by the verified webhook handler and by nothing else.
  paymentVerifiedAt    DateTime?     @map("payment_verified_at") @db.Timestamptz(6)
  orderStatus          OrderStatus   @default(received) @map("order_status")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items OrderItem[]

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerEmail])
  @@map("order")
}

/// Snapshots the name and price at purchase time, so a later rename or reprice never changes an old order.
model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  /// Null when the product has no finishes.
  variantId   String?  @map("variant_id") @db.Uuid
  productName String   @map("product_name")
  sku         String
  variantName String?  @map("variant_name")
  /// Paise.
  unitPrice   Int      @map("unit_price")
  quantity    Int
  /// Paise.
  lineTotal   Int      @map("line_total")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_item")
}

// ─── Forms, settings, audit ────────────────────────────────────────────────

model Submission {
  id         String           @id @default(uuid()) @db.Uuid
  type       SubmissionType
  payload    Json             @db.JsonB
  /// Human readable, CT-2026-0042.
  reference  String           @unique
  status     SubmissionStatus @default(new)
  /// emailSent and emailError let the UI tell the truth when the record saved but the email failed.
  emailSent  Boolean          @default(false) @map("email_sent")
  emailError String?          @map("email_error")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type, status, createdAt])
  @@map("submission")
}

/// Email recipients, sender identity, the WhatsApp number and templates. Change without a deploy.
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json     @db.JsonB
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updater User? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("setting")
}

/// Append only. No update or delete path exists in the API.
model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for system actions, such as a payment webhook.
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  /// Text, not uuid, because some entities are keyed by name (settings).
  entityId   String   @map("entity_id")
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_event")
}
