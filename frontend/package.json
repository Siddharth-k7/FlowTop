{
  "name": "@flowtop/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Flowtop Public Website: Next.js App Router with TypeScript and Tailwind v3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/check-static-routes.mjs --build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "list:mocks": "node scripts/list-mocks.mjs",
    "test:api": "npx tsx scripts/test-api.mjs",
    "test": "node ../packages/ui/scripts/check.mjs && node scripts/check-agents-examples.mjs && node scripts/check-static-routes.mjs --source"
  },
  "dependencies": {
    "@flowtop/types": "file:../shared/types",
    "@flowtop/ui": "file:../packages/ui",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  }
}
